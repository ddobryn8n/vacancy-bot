# Скопируйте этот файл в .env и впишите свои значения. Файл .env в git не попадает.
# В Dokploy те же переменные вписываются на вкладке Environment приложения.

# --- Обязательные ---
# Токен бота от @BotFather
BOT_TOKEN=
# id группы, куда слать вакансии (узнать: python get_chat_id.py). Можно несколько через запятую.
CHAT_ID=
# Пароль для вызова /run из n8n (придумайте длинный, 32+ символа: openssl rand -hex 24)
RUN_TOKEN=

# --- Необязательные ---
# Сколько вакансий максимум за один запуск (n8n запускает раз в 15 минут): 3 запуска x 4 = до 16 в час
FEED_MAX_PER_RUN=3
# Пауза между сообщениями, секунд (лимит Telegram на группу — 20 сообщений в минуту)
FEED_PAUSE_SECONDS=3
# 1 = слать только вакансии, где указана оплата
REQUIRE_PAY=0
# Ещё каналы-источники без правки кода (юзернеймы без @, через запятую)
EXTRA_CHANNELS=
# Из них те, что целиком про тексты (там не требуется слово «удалёнка»)
EXTRA_TEXT_CHANNELS=
# Ваш личный чат с ботом: туда придёт сообщение, если лента сломалась (не чаще раза в 3 часа)
ADMIN_CHAT_ID=
# Где хранить память об отправленном. В Docker уже /data/sent.json, локально можно не задавать.
# SENT_FILE=
